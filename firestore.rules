rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validCurrency(c) {
      return c in ['HTG', 'USD', 'EUR', 'CAD'];
    }

    function chatOpen(uid) {
      return exists(/databases/$(database)/documents/conversations/$(uid))
        && get(/databases/$(database)/documents/conversations/$(uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid','name','email','role','status','balances','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'investor'
        && request.resource.data.status == 'active'
        && request.resource.data.balances.keys().hasOnly(['HTG','USD','EUR','CAD'])
        && request.resource.data.balances.HTG == 0
        && request.resource.data.balances.USD == 0
        && request.resource.data.balances.EUR == 0
        && request.resource.data.balances.CAD == 0;

      allow update, delete: if isAdmin();
    }

    match /levels/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /deposits/{id} {
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validCurrency(request.resource.data.currency)
      );

      allow read: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validCurrency(request.resource.data.currency)
        && request.resource.data.amount <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balances[request.resource.data.currency]
      );

      allow read: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    match /investments/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/levels/$(request.resource.data.levelId))
        && get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.active == true
        && request.resource.data.amount == get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.amount
        && request.resource.data.currency == get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.currency
        && request.resource.data.rate == get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.rate
        && request.resource.data.period == get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.period
        && request.resource.data.amount <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balances[request.resource.data.currency];

      allow read: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    match /exchangeRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validCurrency(request.resource.data.fromCurrency)
        && validCurrency(request.resource.data.toCurrency)
        && request.resource.data.fromCurrency != request.resource.data.toCurrency
        && request.resource.data.amount <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balances[request.resource.data.fromCurrency];

      allow read: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    match /conversations/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && chatOpen(request.auth.uid)
      );

      allow create: if (
        isAdmin()
        && request.resource.data.senderRole == 'service'
        && request.resource.data.keys().hasOnly(['userId','senderRole','text','createdAt'])
      ) || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == 'investor'
        && chatOpen(request.auth.uid)
        && request.resource.data.keys().hasOnly(['userId','senderId','senderRole','text','createdAt'])
      );

      allow update, delete: if isAdmin();
    }
  }
}
